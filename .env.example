# ============================================
# Crypto Signal Bot - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Binance API (optional - leave empty to use public data only) ---
# To create API keys: https://www.binance.com/en/my/settings/api-management
# Recommended: Enable "Read" only, disable trading & withdrawals for safety
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Use https://testnet.binance.vision for testnet, https://api.binance.com for production
BINANCE_BASE_URL=https://api.binance.com
# Set to true if using testnet
BINANCE_TESTNET=false
# v5.30: OPTIONAL REST egress proxy (escape hatch for shared-IP 418 ban
# cycles on PaaS free tiers like Render). Point it at a tiny proxy with a
# DEDICATED IP (e.g. squid/tinyproxy on a cheap VPS):
#   BINANCE_PROXY_URL=http://user:pass@your-vps:3128
# Empty = direct connection (default). The WebSocket feed is unaffected.
BINANCE_PROXY_URL=

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram, get the token
# Then get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to false to disable Telegram notifications
TELEGRAM_ENABLED=false

# --- Web Dashboard ---
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# --- Bot Settings ---
# Run mode: paper | live (paper = no real orders, only signals)
RUN_MODE=paper
# Minimum confidence score to trigger a recommendation (0-100)
MIN_CONFIDENCE=70
# Minimum expected rise percentage to trigger a signal
MIN_EXPECTED_RISE=3.0
# Top 5 recommendations only (sent to Telegram + opened as positions)
MAX_RECOMMENDATIONS=5
# Risk per trade as % of capital
RISK_PER_TRADE=1.0
# Maximum open positions
MAX_OPEN_POSITIONS=5
# Daily stop loss as % of capital (stop trading for the day if hit)
DAILY_MAX_LOSS=5.0
# Risk/Reward minimum ratio
MIN_RR_RATIO=2.0
# Trade size in USD per position (default: $10, configurable)
TRADE_AMOUNT_USD=10
# Binance spot trading fee: 0.1% per side (0.075% if paying with BNB)
TRADING_FEE_PCT=0.1

# --- v5.27: strategy fee-survival tuning (from live paper-day forensics) ---
# The vol floors below are FEE-LINKED: a market whose candle ATR / TP1
# cannot cover the round-trip fee (2 x TRADING_FEE_PCT) is skipped.
# micro_scalp: one resampled 15s/30s candle must travel >= fees x 1.25
SCALP_MIN_ATR_PCT=0.25
SCALP_MIN_RANGE_PCT=0.60
SCALP_FEE_COVER_MULT=1.25
SCALP_MIN_NET_MOVE_PCT=0.15
# double_indicator: TP1 = max(0.70%, fees x 3.5) and 1.8x ATR (>= SL)
DOUBLE_IND_TP1_MIN_PCT=0.70
DOUBLE_IND_TP1_ATR_MULT=1.8
DOUBLE_IND_FEE_TP1_MULT=3.5
# Global trailing: once MFE peaked >= 0.45% and the trade gave back
# >= 0.20% while profit is still < +1%, SL locks entry + fees (+0.02%).
# This is the "a winner must never die as a fee loss" rule.
FEE_SURVIVAL_ENABLED=true
FEE_SURVIVAL_MFE_PCT=0.45
FEE_SURVIVAL_GIVEBACK_PCT=0.20
FEE_SURVIVAL_NET_PCT=0.02

# --- v5.28: evidence-based strategy overhaul (scripts/research/) ---
# New TREND BOOST channel: two entry families selected by a fee-honest
# walk-forward harness on ~500 days of real 4h klines (donchian_break
# +28.3 bps/trade PF 1.98, st_flip +14.7 bps/trade PF 1.50 - all folds
# positive). Evaluated on CLOSED 4h candles from the WS cache: zero
# extra REST weight. Geometry: SL 2.0xATR / TP1 2.4xATR / TP2 4.8xATR.
TREND_BOOST_ENABLED=true
TREND_DONCHIAN_PERIOD=55
TREND_VOL_MULT=1.2
TREND_ST_PERIOD=10
TREND_ST_MULT=3.0
TREND_EMA_PERIOD=200
TREND_SL_ATR=2.0
TREND_TP1_ATR=2.4
TREND_TP2_ATR=4.8
TREND_MIN_ATR_PCT=0.30
TREND_MAX_ATR_PCT=3.5
TREND_TOP_N=40
TREND_KLINES_LIMIT=300
TREND_MIN_SCORE=62
TREND_CONF_CAP=72
TREND_MAX_PER_CYCLE=2
TREND_MAX_OPEN_CONCURRENT=3
TREND_ENTRY_SPACING_MIN=60
TREND_SYMBOL_COOLDOWN_MIN=240
# Research: tide-filtering Donchian LOWERED expectancy (+28.3 -> +21.5
# bps) - the global market-tide gate still protects every entry.
TREND_BTC_TIDE_GATE=false
# Starvation fix: solo votes needed strength 86-93 to clear
# MIN_CONFIDENCE=68 under REF=5.8 (live: ZERO composite trades ever).
# REF=2.0 admits solo full signals at strength >= ~57 - all of them
# validated profitable by the research baseline.
STRATEGY_CONFLUENCE_REF_WEIGHT=2.0
# Composites retired by the same baseline (code kept, re-enable freely):
# liquidity_sweep -6.9 bps/trade PF 0.81 ALL folds negative; trend_pullback
# -0.5 bps/trade PF 0.99. volatility_breakout (+18.9 bps) stays ON.
STRATEGY_VOL_BREAKOUT_ENABLED=true
STRATEGY_TREND_PULLBACK_ENABLED=false
STRATEGY_LIQUIDITY_SWEEP_ENABLED=false

# --- Analysis Settings ---
# Timeframes to analyze (single for scalping: "15m"; multi for confirmation: "15m,1h,4h")
TIMEFRAMES=15m
# How often to run the analysis (cron format: minute hour day month weekday)
# Default: every 5 minutes (suitable for 15m timeframe)
SCHEDULE_CRON=*/5 * * * *
# Order book depth to fetch
ORDER_BOOK_DEPTH=20
# Number of candles to fetch for analysis
CANDLE_LIMIT=200

# --- Reinforcement Learning (OPTIONAL, ADVANCED) ---
# Set to "true" to enable RL Ensemble Strategy (DQN + PPO + A2C voting)
# Requires installing requirements-rl.txt and training models first:
#   pip install -r requirements-rl.txt
#   python scripts/train_rl_agents.py --symbol BTCUSDT --interval 1h --limit 2000
ENABLE_RL_STRATEGY=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=data/logs/bot.log

# --- GitHub (for upload script only) ---
GITHUB_TOKEN=
GITHUB_REPO_NAME=crypto-signal-bot
GITHUB_REPO_DESCRIPTION=Cryptocurrency Spot Trading Signal Bot for Binance with Multi-Strategy Analysis

# --- v5.26: Dashboard control-plane auth (IMPORTANT - set this!) ---
# POST /api/run-analysis, /api/scan-bottoms and /api/reset-history require
# this token ('Authorization: Bearer <token>'). UNSET = those endpoints are
# DISABLED (403). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=
# Optional: comma-separated origins allowed cross-origin with credentials
# (empty = none; the bundled dashboard is same-origin and needs none)
CORS_ALLOWED_ORIGINS=
